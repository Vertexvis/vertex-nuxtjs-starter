    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-simple-import-sort": "^10.0.0",
    "eslint-plugin-vue": "^9.33.0",
    "nuxt": "^3.21.2",
    "prettier": "^3.8.3",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@vertexvis/api-client-node": "^0.42.0",
    "@vertexvis/utils": "^1.0.0-testing.2",
    "@vertexvis/viewer-vue": "^1.0.0-testing.2",
    "tslib": "^2.8.1",
