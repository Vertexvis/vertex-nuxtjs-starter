    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-simple-import-sort": "^10.0.0",
    "eslint-plugin-vue": "^9.33.0",
    "nuxt": "^3.21.8",
    "prettier": "^3.8.5",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@vertexvis/api-client-node": "^0.42.3",
    "@vertexvis/utils": "^1.0.1",
    "@vertexvis/viewer-vue": "^1.0.1",
